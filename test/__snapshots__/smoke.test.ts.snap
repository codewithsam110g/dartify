  external bool? get markersInheritOptions;
  external set markersInheritOptions(bool? value);
  /// A Function defining how GeoJSON points spawn Leaflet layers.
  /// It is internally called when data is added, passing the GeoJSON point
  /// feature and its LatLng.
  ///
  /// The default is to spawn a default Marker:
  ///
  /// \`\`\`
  /// function(geoJsonPoint, latlng) {
  ///     return L.marker(latlng);
  /// }
  /// \`\`\`
  external Layer pointToLayer(GeojsonFeature geoJsonPoint, LatLng latlng);
  /// A Function that will be called once for each created Feature, after it
  /// has been created and styled. Useful for attaching events and popups to features.
  ///
  /// The default is to do nothing with the newly created layers:
  ///
  /// \`\`\`
  /// function (feature, layer) {}
